# Engineering Society landing: environment variables (names and meaning only; never real values).
# Copy to .env.local for local work. .env*.local is git-ignored: never commit it.
#
# Core API (events and registrations): see lib/core-api/README.md.
# None of these is ever exposed to the browser. There is deliberately no NEXT_PUBLIC_ Core variable.

# Origin of the Core API, without /v1 and without a trailing slash, e.g. the staging Core origin
# Core provides. https only (http is accepted for localhost only). No default: when unset,
# production shows an honest "events unavailable" state, and local `next dev` uses fixtures.
CORE_API_BASE_URL=

# Server-only bearer key for the event reads, ONLY if Core decides event GETs need one.
# Never prefix with NEXT_PUBLIC_. Leave empty while Core's GETs are public.
CORE_EVENTS_API_KEY=

# http | fixtures. Leave empty for the default (http when CORE_API_BASE_URL is set).
# fixtures = synthetic development data; refused on Vercel production whatever is set here.
CORE_API_MODE=

# Fixture scenario when CORE_API_MODE=fixtures: default | empty | unavailable | malformed
CORE_API_FIXTURE_SCENARIO=

# true lets a local `next build && next start` use fixtures (CI/E2E). Ignored on Vercel production.
CORE_API_ALLOW_FIXTURES=

# Per-request timeout for Core reads, in ms (500–15000, default 4000).
CORE_API_TIMEOUT_MS=

# Event list/detail cache lifetime, in seconds (0–3600, default 45; 0 disables caching).
CORE_EVENTS_REVALIDATE_SECONDS=

# true switches on the browser registration form against Core. Leave off until Core publishes
# the registration contract and allows this site's origins in CORS.
CORE_REGISTRATION_ENABLED=

# true logs every Core request (route template, status, latency, request id); failures are always logged.
CORE_API_DEBUG=
